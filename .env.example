# GitHub Configuration
# If GITHUB_TOKEN is omitted, CodeFix automatically attempts to resolve it via `gh auth token`
GITHUB_TOKEN=
GITHUB_OWNER=ABDULMUNAFZ
GITHUB_REPO=codefix-demo
GITHUB_ISSUE_NUMBER=2

# TrueForge Integration
TRUEFORGE_URL=http://127.0.0.1:8790
MODEL_PROVIDER=openai
MODEL_NAME=openai/gpt-5-4-mini

# Sandbox Configuration
SANDBOX_BASE_DIR=/tmp/codefix-sandboxes
EXEC_TIMEOUT_MS=60000

# Demo Mode (auto-approval for non-interactive test suites if set to true; defaults to false/interactive)
CODEFIX_AUTO_APPROVE=false
