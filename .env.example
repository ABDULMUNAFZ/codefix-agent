# Copy to .env (git-ignored). Only `npm run setup` / `npm run demo` read this file.

# TrueForge server (local: `npx @truefoundry/trueforge`)
TRUEFORGE_URL=http://localhost:8790
# Only needed when TrueForge runs with authentication enabled
TRUEFORGE_API_TOKEN=

# Model FQN as listed by TrueForge (GET /api/v1/models), e.g. anthropic/<model>
CODEFIX_MODEL=

# The one repository CodeFix may act on
CODEFIX_TARGET_REPO=ABDULMUNAFZ/codefix-demo

# Public repo + ref TrueForge clones the codefix skill from
CODEFIX_SKILL_REPO_URL=https://github.com/ABDULMUNAFZ/codefix-agent
CODEFIX_SKILL_REF=main

# GitHub MCP connector name in TrueForge
CODEFIX_GITHUB_MCP_NAME=github

# Fine-grained PAT limited to CODEFIX_TARGET_REPO. Setup hands it to TrueForge's
# connector store and never prints it. Leave empty to keep the stored token.
GITHUB_PAT=
